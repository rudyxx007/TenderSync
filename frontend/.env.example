# Supabase Configuration
# Replace with your actual project URL and publishable key from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Backend FastAPI URL (Local development / Cloudflare tunnel URL)
# For local dev: http://localhost:8000 or http://127.0.0.1:8000
# For cloudflare tunnel / production: https://your-tunnel-subdomain.trycloudflare.com
VITE_API_URL=your_cloudflare_tunnel_url
