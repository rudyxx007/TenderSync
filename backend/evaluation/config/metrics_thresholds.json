{
  "description": "Release gates for the TenderSync RAG pipeline",
  "version": "2.0",
  "thresholds": {
    "context_recall": {
      "min": 0.80,
      "target": 0.90,
      "required": true,
      "description": "Share of ground-truth evidence present in retrieved context"
    },
    "context_precision": {
      "min": 0.70,
      "target": 0.85,
      "required": true,
      "description": "Ranking quality of retrieved evidence"
    },
    "faithfulness": {
      "min": 0.85,
      "target": 0.95,
      "required": true,
      "description": "Share of answer sentences supported by retrieved evidence"
    },
    "answer_relevance": {
      "min": 0.75,
      "target": 0.90,
      "required": true,
      "description": "How directly the answer addresses the query"
    },
    "ndcg": {
      "min": 0.75,
      "target": 0.90,
      "required": false,
      "description": "NDCG@10 of retrieved evidence"
    },
    "answer_similarity": {
      "min": 0.70,
      "target": 0.85,
      "required": false,
      "description": "Token F1 against the reference answer"
    },
    "compliance_score_accuracy": {
      "min": 0.80,
      "target": 0.95,
      "required": false,
      "description": "Accuracy of extracted compliance percentages"
    },
    "budget_extraction_accuracy": {
      "min": 0.80,
      "target": 0.95,
      "required": false,
      "description": "Accuracy of extracted contract values"
    },
    "citation_verification_rate": {
      "min": 0.90,
      "target": 0.98,
      "required": false,
      "description": "Share of claims with supporting evidence"
    }
  },
  "category_thresholds": {
    "compliance": {
      "context_recall": 0.90,
      "faithfulness": 0.95
    },
    "budget": {
      "context_recall": 0.85,
      "answer_relevance": 0.85
    },
    "deadline": {
      "context_recall": 0.90,
      "answer_relevance": 0.85
    }
  },
  "ablation_comparison": {
    "enabled": true,
    "min_improvement": 0.05,
    "significant_metrics": ["context_recall", "faithfulness", "ndcg"]
  }
}
